# Use fresh URL-safe random values for both passwords.
POSTGRES_PASSWORD=
FACTORYIQ_OPERATOR_TOKEN=
FACTORYIQ_DEMO_READS=true
FACTORYIQ_READ_ONLY=false
# Required by docker compose --profile iot. The broker's default listener is container-only.
FACTORYIQ_MQTT_BRIDGE_PASSWORD=
FACTORYIQ_MQTT_DEVICE_SECRET=
FACTORYIQ_SIMULATE=true
